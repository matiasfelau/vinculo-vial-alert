# Puerto HTTP del servicio (Kong lo alcanza acá). Alert no expone ninguna
# ruta /internal/*: el único endpoint interno del contrato de US-05
# (/internal/resolve-owner) lo implementa vinculo-vial-vehicle, no este
# servicio, así que no hace falta un puerto interno separado.
PORT=8080

# Cadena de conexión a la base de datos PostgreSQL propia del servicio
# (database-per-service). Dentro de docker-compose apunta al container_name
# vinculo-vial-alert-db, que no publica su puerto al host: solo es
# alcanzable desde la red interna alert-internal.
DATABASE_URL=postgres://alert:alert@vinculo-vial-alert-db:5432/alert?sslmode=disable

# URL interna (red vinculo-vial, nunca expuesta en Kong) del endpoint
# POST /internal/resolve-owner de vinculo-vial-vehicle. Alert reenvía el
# criptograma pat_enc tal cual lo recibe: no posee la clave HPKE de
# Vehicle y no puede descifrarlo.
VEHICLE_INTERNAL_URL=http://vinculo-vial-vehicle:8081

# Timeout explícito, en milisegundos, para la llamada a Vehicle. El
# servicio no reintenta indefinidamente: una única solicitud con este
# límite de tiempo total: si se cumple, se responde 503 sin persistir ni
# publicar.
VEHICLE_TIMEOUT_MS=2000

# Circuit breaker sobre la llamada a Vehicle. Tras VEHICLE_BREAKER_FAILURE_THRESHOLD
# fallas consecutivas por timeout, error de conexión o 5xx (nunca por un
# 4xx: eso es un error de configuración propio, no una caída de Vehicle),
# el circuito se abre y las siguientes solicitudes fallan de inmediato con
# 503 sin llamar a Vehicle durante VEHICLE_BREAKER_OPEN_DURATION_MS.
# Pasado ese tiempo, se deja pasar una única solicitud de prueba.
VEHICLE_BREAKER_FAILURE_THRESHOLD=5
VEHICLE_BREAKER_OPEN_DURATION_MS=30000

# Token compartido para autorizar tráfico de servicio a servicio en la red
# interna. Se envía en el header X-Internal-Service-Token en cada llamada
# saliente a POST /internal/resolve-owner; Vehicle exige ese mismo valor
# para aceptar la solicitud y responde 401 en caso contrario.
INTERNAL_SERVICE_TOKEN=reemplazar-con-el-secreto-compartido-del-ecosistema

# URL de conexión al broker RabbitMQ compartido por el ecosistema,
# alcanzable a través de la red externa vinculo-vial. La topología
# (exchange, colas, retry, DLQ) la declara vinculo-vial-core; este
# servicio únicamente publica. Si el broker está inalcanzable al arrancar,
# el servicio NO aborta: arranca en modo degradado y reconecta en
# background, para que las rutas que no publican (ej. GET /alerts/inbox)
# sigan sirviendo. Solo aborta el arranque si RABBITMQ_EXCHANGE no existe
# (eso sí es un error de despliegue).
RABBITMQ_URL=amqp://guest:guest@vinculo-vial-rabbitmq:5672/

# Exchange topic donde se publica el evento alert.created con routing key
# alert.created, siguiendo el Event Envelope estándar de la plataforma
# (issuer_id en actor, nunca en payload). Alert verifica con una
# declaración pasiva que este exchange ya exista al arrancar y al
# reconectar: nunca lo crea (eso es responsabilidad exclusiva de
# vinculo-vial-core), así que si no existe todavía el servicio falla en
# vez de levantar infraestructura con una configuración adivinada.
RABBITMQ_EXCHANGE=vvi.topic.exchange

# --- Presupuesto de timeouts (todas opcionales, con default razonable) ---

# Cantidad máxima de conexiones simultáneas al Postgres propio del
# servicio. Evita que una ráfaga de tráfico agote las conexiones
# disponibles del lado del servidor.
DB_MAX_OPEN_CONNS=20

# Límite, en milisegundos, que Postgres aplica del lado del servidor a
# cualquier sentencia SQL (statement_timeout). Protege contra una consulta
# colgada aunque el cliente Go no respete su propio contexto.
DB_STATEMENT_TIMEOUT_MS=3000

# Read/WriteTimeout del servidor HTTP, en milisegundos. Sin ellos, un
# cliente lento (o que nunca cierra la conexión) retiene la goroutine del
# request sin límite de tiempo.
HTTP_READ_TIMEOUT_MS=5000
HTTP_WRITE_TIMEOUT_MS=10000

# Timeout, en milisegundos, del propio basic.publish a RabbitMQ. El
# contexto del request HTTP no trae un deadline para esta llamada: sin
# este timeout, un broker en flow control bloquearía el request.
RABBITMQ_PUBLISH_TIMEOUT_MS=2000

# Worker de outbox: publica en background los eventos alert.created
# persistidos en la misma transacción que la alerta (patrón transactional
# outbox). POST /alerts no depende de RabbitMQ en absoluto: solo este
# worker lo necesita. OUTBOX_WORKER_INTERVAL_MS es cada cuánto revisa si
# hay eventos pendientes; OUTBOX_WORKER_BATCH_SIZE acota cuántos intenta
# publicar por ciclo.
OUTBOX_WORKER_INTERVAL_MS=2000
OUTBOX_WORKER_BATCH_SIZE=20

# Presupuesto total del apagado ordenado (SIGTERM): drenar requests en vuelo
# y cortar el worker de outbox. Debe ser MENOR que stop_grace_period de
# docker-compose.yml (10 s); si no, SIGKILL llega antes de terminar.
SHUTDOWN_TIMEOUT_MS=8000

# --- Consumo RabbitMQ (aplica a todos los consumidores del servicio) ---

# basic.qos: cantidad máxima de mensajes sin ack que cada consumidor puede
# tener en vuelo. Sin este límite el broker empuja toda la cola al proceso.
# Debe ser mayor o igual a 1.
RABBITMQ_PREFETCH=10

# Reintentos máximos de un mensaje con fallo transitorio. Se cuentan con el
# header x-death de la cola de trabajo; al superarlo, el mensaje se publica
# en la DLQ (con publisher confirm) y recién entonces se hace ack. Los
# mensajes inválidos (deserialización o validación) van directo a la DLQ,
# sin reintento. No puede ser negativo.
MAX_RETRIES=5
